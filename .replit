modules = ["nodejs-20", "web"]
run = "npm run dev"

[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "npm run dev"]

[[ports]]
localPort = 3000
externalPort = 3003

[[ports]]
localPort = 5000
externalPort = 3000

[[ports]]
localPort = 5173
externalPort = 5000

[[ports]]
localPort = 5174
externalPort = 80

[[ports]]
localPort = 5175

[[ports]]
localPort = 5176
externalPort = 3001

[[ports]]
localPort = 5177
externalPort = 3002

[[ports]]
localPort = 5178
externalPort = 4200

[workflows]
runButton = "Run"

[[workflows.workflow]]
name = "Run"
author = 27304601
mode = "parallel"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node server.js"

[[workflows.workflow]]
name = "arrow"
mode = "sequential"
author = 27304601

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "echo \"Starting AI Simulation Server with Express proxy...\""

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node server.js"

[[workflows.workflow]]
name = "Run"
author = 27304601
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
